  "methods": {
    "log_return_20": {
      "formula": "ln(P[t]/P[t-20])",
      "minimum_points": 21,
      "zero_or_invalid_price": "SOURCE_ERROR",
      "output_unit": "log_return"
    },
    "relative_log_return_20": {
      "formula": "ln(A[t]/A[t-20])-ln(B[t]/B[t-20])",
      "minimum_points_per_feed": 21,
      "alignment": "same_XNYS_session_endpoints",
      "output_unit": "log_return"
    },
    "sample_rv_20": {
      "formula": "100*sqrt(252)*sample_std(log_daily_returns[t-19:t], ddof=1)",
      "minimum_points": 21,
      "output_unit": "percent_annualized"
    },
    "rv_ratio_5_20": {
      "formula": "sample_std(last_5_returns,ddof=1)/sample_std(last_20_returns,ddof=1)",
      "minimum_points": 21,
      "zero_denominator": "INSUFFICIENT_HISTORY",
      "output_unit": "ratio"
    },
    "latest_point": {
      "formula": "latest_eligible_point_at_cutoff",
      "minimum_points": 1,
      "output_unit": "SAME_AS_INPUT"
    },
    "implied_minus_realized_20": {
      "formula": "VIX[t]-RV20[t]",
      "alignment": "same_observation_session",
      "meaning": "horizon_mismatched_implied_realized_gap_not_true_variance_risk_premium",
      "output_unit": "percentage_points"
    },
    "yield_slope": {
      "formula": "100*(UST10Y[t]-UST2Y[t])",
      "alignment": "same_observation_session",
      "output_unit": "basis_points"
    },
    "funding_spread": {
      "formula": "100*(SOFR[t]-EFFR[t])",
      "alignment": "same_observation_session",
      "meaning": "descriptive_funding_context_not_automatic_stress",
      "output_unit": "basis_points"
    },
    "sector_relative_vector_20": {
      "formula": "relative_log_return_20(sector,SPY)_for_each_sector",
      "required_members": 9,
      "aggregation": "sorted_vector_no_sector_vote_or_rank_when_incomplete",
      "output_unit": "log_return"
    },
    "pit_positive_return_fraction_20": {
      "formula": "eligible_positive_20_session_total_return_members/current_PIT_members",
      "activation": "requires_new_version_and_validated_PIT_membership",
      "member_coverage_min": 0.95,
      "output_unit": "fraction"
    },
    "pit_top7_weight_fraction": {
      "formula": "sum_of_seven_largest_current_PIT_constituent_weights",
      "activation": "requires_new_version_and_validated_PIT_weights",
      "meaning": "top_seven_by_weight_not_Mega7",
      "output_unit": "fraction"
    },
    "pit_fixed_group_contribution_20": {
      "formula": "not_enabled_until_PIT_group_definition_and_contribution_accounting_are_frozen",
      "activation": "requires_new_version_and_validated_PIT_group_membership_and_weights",
      "output_unit": "return_contribution"
    }
  },
  "availability": {
    "decision_calendar": "XNYS_VERSIONED",
    "decision_offset_minutes_after_actual_close": 120,
    "timestamp_timezone": "UTC",
    "session_timezone": "America/New_York",
    "eligibility": "max(published_at,first_seen_at)<=decision_cutoff",
    "unknown_publication": "use_first_seen_at_only_no_backdating",
    "observation_must_be_completed": true,
    "point_vintage_selection": "latest_available_revision_at_cutoff",
    "history_must_be_available_at_cutoff": true,
    "fill_missing_sessions": false,
    "non_available_value_policy": "NULL",
    "missing_weight_policy": "UNAVAILABLE_NO_REWEIGHT",
    "delayed_release": "retain_original_observation_time_no_relabel_as_current",
    "historical_latest_vintage_role": "DESCRIPTIVE_ONLY_NOT_CAUSAL_CONFIRMATION",
    "max_age_unit": "completed_XNYS_sessions",
    "revision_replay_policy": "append_only_do_not_rewrite_emitted_snapshots",
    "failure_precedence": [
      "SOURCE_ERROR",
      "UNSUPPORTED_SESSION",
      "UNAVAILABLE",
      "STALE",
      "INSUFFICIENT_HISTORY",
      "AVAILABLE"
    ],
    "maximum_reference_source_age_sessions": 0,
    "consecutive_return_sessions_required": true
  },
